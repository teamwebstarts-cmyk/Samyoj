[Unit]
Description=Run Samyoj nightly PostgreSQL backup

[Timer]
# 01:30 UTC = 07:00 IST, before the workday.
OnCalendar=*-*-* 01:30:00 UTC
# Catch up after a reboot or a missed run instead of silently skipping a day.
Persistent=true
AccuracySec=1min
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
