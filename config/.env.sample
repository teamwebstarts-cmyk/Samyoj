# =============================================================================
# Shared environment sample (Skillr-style monorepo layout)
# Copy values into server/.env (and client/.env for Vite overrides if needed).
# =============================================================================

# --- Server ---
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:8000
SERVER_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000

# Production (single domain serves UI + API):
# BASE_URL=https://myapp.com
# SERVER_URL=https://myapp.com
# CLIENT_URL=https://myapp.com

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_platform

# --- Redis ---
REDIS_URL=redis://localhost:6379
