# =============================================================================
# WhatsApp Platform — Client Environment
# Copy to .env:
#   cp .env.example .env
# =============================================================================

# Optional: absolute API origin for cross-origin deployments.
# Leave unset in dev/prod same-origin — resolved from window.location.origin.
# VITE_API_ORIGIN=https://myapp.com

# Optional: explicit Socket.IO origin (split deployments only).
# VITE_SOCKET_URL=https://myapp.com

# Dev: Vite on :3000 proxies /api and /socket.io → http://localhost:8000
# Prod: Express on :8000 serves client/dist + /api (same origin, no env needed).
# Local ngrok (bash start.sh) writes VITE_DEV_HTTPS_ORIGIN — open that URL for WhatsApp Connect.

VITE_APP_NAME=WhatsApp Platform

# -----------------------------------------------------------------------------
# PreConnect dashboard videos (optional)
# YouTube / Vimeo watch URLs, or a public file path under client/public
# (e.g. /dashboard/videos/intro.mp4). Restart Vite after changing.
# Learn cards fall back to VITE_PRECONNECT_VIDEO_URL when their own key is empty.
# -----------------------------------------------------------------------------
# VITE_PRECONNECT_VIDEO_URL=
# VITE_PRECONNECT_VIDEO_API=
# VITE_PRECONNECT_VIDEO_HOW=
# VITE_PRECONNECT_VIDEO_BENEFITS=
# VITE_PRECONNECT_VIDEO_NEXT=
