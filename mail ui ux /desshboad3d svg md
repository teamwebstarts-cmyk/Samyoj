<svg
  xmlns="http://www.w3.org/2000/svg"
  width="744"
  height="252"
  viewBox="0 0 248 84"
  role="img"
  aria-labelledby="t d"
  shape-rendering="geometricPrecision"
>
  <title id="t">Email with connected user profiles</title>
  <desc id="d">3D open envelope with a letter, two user cards, a paper plane with a dotted trail and sparkles.</desc>

  <defs>
    <style>
      .fa{animation:fa 6s ease-in-out infinite}
      .fb{animation:fb 7s ease-in-out infinite}
      .fc{animation:fa 8s ease-in-out infinite reverse}
      .tw{animation:tw 3s ease-in-out infinite;transform-box:fill-box;transform-origin:center}
      .tw2{animation-delay:1s}
      .tw3{animation-delay:1.9s}
      @keyframes fa{0%,100%{transform:translateY(0)}50%{transform:translateY(-1.6px)}}
      @keyframes fb{0%,100%{transform:translateY(0)}50%{transform:translateY(1.4px)}}
      @keyframes tw{0%,100%{opacity:.6;transform:scale(.85)}50%{opacity:1;transform:scale(1.05)}}
      @media (prefers-reduced-motion:reduce){.fa,.fb,.fc,.tw{animation:none}}
    </style>

    <!-- ============ BACKGROUND ============ -->
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e1e9fc"/>
      <stop offset=".5" stop-color="#eae7fb"/>
      <stop offset="1" stop-color="#f3ebf8"/>
    </linearGradient>
    <radialGradient id="glowWhite" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#fff" stop-opacity=".95"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glowBlue" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#b7c8ff" stop-opacity=".55"/>
      <stop offset="1" stop-color="#b7c8ff" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glowPink" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#f7cfee" stop-opacity=".6"/>
      <stop offset="1" stop-color="#f7cfee" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="floor" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0"/>
      <stop offset="1" stop-color="#fff" stop-opacity=".55"/>
    </linearGradient>

    <!-- ============ CARDS ============ -->
    <linearGradient id="cardFace" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="1" stop-color="#f3f4fc"/>
    </linearGradient>
    <linearGradient id="cardEdge" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d9def4"/>
      <stop offset="1" stop-color="#c3c9ec"/>
    </linearGradient>
    <linearGradient id="cardGloss" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="1"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>

    <linearGradient id="avBlue" x1=".15" y1="0" x2=".85" y2="1">
      <stop offset="0" stop-color="#84c6ff"/>
      <stop offset=".55" stop-color="#4b8ef4"/>
      <stop offset="1" stop-color="#3468e6"/>
    </linearGradient>
    <linearGradient id="avPurple" x1=".15" y1="0" x2=".85" y2="1">
      <stop offset="0" stop-color="#d69bf8"/>
      <stop offset=".55" stop-color="#a55be6"/>
      <stop offset="1" stop-color="#8340d6"/>
    </linearGradient>
    <radialGradient id="avShine" cx=".3" cy=".2" r=".8">
      <stop offset="0" stop-color="#fff" stop-opacity=".55"/>
      <stop offset=".5" stop-color="#fff" stop-opacity=".08"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="avRim" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".85"/>
      <stop offset="1" stop-color="#fff" stop-opacity=".15"/>
    </linearGradient>
    <clipPath id="avClip"><circle r="9.6"/></clipPath>

    <!-- white person glyph (origin-centered) -->
    <g id="person" clip-path="url(#avClip)">
      <g fill="#2a2f8f" opacity=".2" transform="translate(.5 .9)">
        <circle cx="0" cy="-3" r="3.5"/>
        <path d="M-8 10C-8 3.2-4.6 1.4 0 1.4S8 3.2 8 10Z"/>
      </g>
      <circle cx="0" cy="-3" r="3.5" fill="#fff"/>
      <path d="M-8 10C-8 3.2-4.6 1.4 0 1.4S8 3.2 8 10Z" fill="#fff"/>
    </g>

    <!-- ============ ENVELOPE ============ -->
    <linearGradient id="envBack" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4a69dd"/>
      <stop offset="1" stop-color="#5a4fd0"/>
    </linearGradient>
    <linearGradient id="envFlap" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c4d0ff"/>
      <stop offset="1" stop-color="#94a6f6"/>
    </linearGradient>
    <linearGradient id="envBody" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5aa2ff"/>
      <stop offset=".5" stop-color="#6b80f4"/>
      <stop offset="1" stop-color="#8558e8"/>
    </linearGradient>
    <linearGradient id="panL" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5b9bfd"/>
      <stop offset="1" stop-color="#6a86f5"/>
    </linearGradient>
    <linearGradient id="panR" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6d80f3"/>
      <stop offset="1" stop-color="#8a5eea"/>
    </linearGradient>
    <linearGradient id="panB" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8ba8ff"/>
      <stop offset=".5" stop-color="#8580f2"/>
      <stop offset="1" stop-color="#8c62ec"/>
    </linearGradient>
    <linearGradient id="envGloss" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".5"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="envDark" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2b1f86" stop-opacity="0"/>
      <stop offset="1" stop-color="#2b1f86" stop-opacity=".28"/>
    </linearGradient>
    <clipPath id="frontClip">
      <path d="M94 44Q94 40 98 40H160Q164 40 164 44V66Q164 76 154 76H104Q94 76 94 66Z"/>
    </clipPath>

    <!-- ============ LETTER ============ -->
    <linearGradient id="paper" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="1" stop-color="#eef1fb"/>
    </linearGradient>
    <linearGradient id="bar" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#66a0ff"/>
      <stop offset="1" stop-color="#8e6cf3"/>
    </linearGradient>
    <linearGradient id="paperShade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4b3fb4" stop-opacity="0"/>
      <stop offset="1" stop-color="#4b3fb4" stop-opacity=".3"/>
    </linearGradient>

    <!-- ============ PLANE ============ -->
    <linearGradient id="pWingTop" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#9dd0ff"/>
      <stop offset="1" stop-color="#6f95ff"/>
    </linearGradient>
    <linearGradient id="pWingLow" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5f7ef5"/>
      <stop offset="1" stop-color="#7b5ee6"/>
    </linearGradient>
    <linearGradient id="pFold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4a45cc"/>
      <stop offset="1" stop-color="#6a3fc4"/>
    </linearGradient>

    <!-- ============ TRAIL ============ -->
    <linearGradient id="trail" gradientUnits="userSpaceOnUse" x1="165" y1="54" x2="201" y2="28">
      <stop offset="0" stop-color="#6a8dff"/>
      <stop offset=".5" stop-color="#a068f2"/>
      <stop offset="1" stop-color="#f27ac6"/>
    </linearGradient>

    <!-- ============ SPARKLES ============ -->
    <linearGradient id="spBlue" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7ab6ff"/>
      <stop offset="1" stop-color="#4a7cf0"/>
    </linearGradient>
    <linearGradient id="spOrange" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffc656"/>
      <stop offset="1" stop-color="#ff8e3c"/>
    </linearGradient>
    <linearGradient id="spPink" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffa8dc"/>
      <stop offset="1" stop-color="#e768c4"/>
    </linearGradient>
    <path id="spk" d="M0 -1C.1 -.34 .34 -.1 1 0C.34 .1 .1 .34 0 1C-.1 .34 -.34 .1 -1 0C-.34 -.1 -.1 -.34 0 -1Z"/>

    <!-- ============ FILTERS ============ -->
    <filter id="shCard" x="-40%" y="-40%" width="180%" height="190%" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="2.6" stdDeviation="2.6" flood-color="#6f68b0" flood-opacity=".26"/>
    </filter>
    <filter id="shEnv" x="-30%" y="-30%" width="160%" height="170%" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#4f3fb0" flood-opacity=".34"/>
    </filter>
    <filter id="shLetter" x="-30%" y="-20%" width="160%" height="150%" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="1.2" stdDeviation="1.6" flood-color="#5b4fb5" flood-opacity=".24"/>
    </filter>
    <filter id="shAv" x="-50%" y="-50%" width="200%" height="220%" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="1.3" stdDeviation="1.2" flood-color="#2e3fa6" flood-opacity=".38"/>
    </filter>
    <filter id="shPlane" x="-60%" y="-60%" width="220%" height="240%" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="2" stdDeviation="1.8" flood-color="#4a3fb8" flood-opacity=".32"/>
    </filter>
    <filter id="blur1" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="1"/></filter>
    <filter id="blur2" x="-50%" y="-200%" width="200%" height="500%"><feGaussianBlur stdDeviation="2.4"/></filter>
    <filter id="blur10" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9"/></filter>
  </defs>

  <!-- ==================== BACKGROUND ==================== -->
  <rect width="248" height="84" fill="url(#bg)"/>
  <ellipse cx="50" cy="42" rx="70" ry="46" fill="url(#glowWhite)" opacity=".8"/>
  <ellipse cx="135" cy="40" rx="80" ry="50" fill="url(#glowWhite)" opacity=".75"/>
  <ellipse cx="100" cy="60" rx="70" ry="32" fill="url(#glowBlue)"/>
  <ellipse cx="220" cy="50" rx="52" ry="40" fill="url(#glowPink)"/>
  <ellipse cx="128" cy="86" rx="130" ry="14" fill="#fff" opacity=".35" filter="url(#blur10)"/>
  <rect y="60" width="248" height="24" fill="url(#floor)"/>

  <!-- ==================== DOTTED TRAIL ==================== -->
  <path d="M165 54C175 59 179 55 184 46C188 38 194 33 201 28"
        fill="none" stroke="url(#trail)" stroke-width="3.2" stroke-linecap="round"
        stroke-dasharray="0.01 4.2" opacity=".28" filter="url(#blur1)"/>
  <path d="M165 54C175 59 179 55 184 46C188 38 194 33 201 28"
        fill="none" stroke="url(#trail)" stroke-width="1.5" stroke-linecap="round"
        stroke-dasharray="0.01 3.5"/>

  <!-- ==================== LEFT CARDS ==================== -->
  <!-- Top card (blue avatar) -->
  <g class="fa">
    <g transform="translate(55 25) rotate(-5)" filter="url(#shCard)">
      <rect x="-19" y="-15.5" width="38" height="35" rx="10" fill="url(#cardEdge)"/>
      <rect x="-19" y="-17.5" width="38" height="35" rx="10" fill="url(#cardFace)"/>
      <path d="M-9 -17.5H9Q19 -17.5 19 -7.5C8 -10.5 -8 -10.5 -19 -7.5Q-19 -17.5 -9 -17.5Z" fill="url(#cardGloss)" opacity=".7"/>
      <rect x="-18.6" y="-17.1" width="37.2" height="34.2" rx="9.6" fill="none" stroke="#e5e8f8" stroke-width=".5"/>
      <g transform="translate(0 0)">
        <circle r="10.9" fill="#fff"/>
        <g filter="url(#shAv)">
          <circle r="9.6" fill="url(#avBlue)"/>
        </g>
        <circle r="9.6" fill="url(#avShine)"/>
        <circle r="9.3" fill="none" stroke="url(#avRim)" stroke-width=".5"/>
        <ellipse cx="-3.6" cy="-6.2" rx="3.8" ry="1.3" fill="#fff" opacity=".4" transform="rotate(-32 -3.6 -6.2)"/>
        <use href="#person"/>
      </g>
    </g>
  </g>

  <!-- Bottom card (purple avatar) -->
  <g class="fb">
    <g transform="translate(67 61.5) rotate(4)" filter="url(#shCard)">
      <rect x="-19" y="-15.5" width="38" height="35" rx="10" fill="url(#cardEdge)"/>
      <rect x="-19" y="-17.5" width="38" height="35" rx="10" fill="url(#cardFace)"/>
      <path d="M-9 -17.5H9Q19 -17.5 19 -7.5C8 -10.5 -8 -10.5 -19 -7.5Q-19 -17.5 -9 -17.5Z" fill="url(#cardGloss)" opacity=".7"/>
      <rect x="-18.6" y="-17.1" width="37.2" height="34.2" rx="9.6" fill="none" stroke="#e5e8f8" stroke-width=".5"/>
      <g>
        <circle r="10.9" fill="#fff"/>
        <g filter="url(#shAv)">
          <circle r="9.6" fill="url(#avPurple)"/>
        </g>
        <circle r="9.6" fill="url(#avShine)"/>
        <circle r="9.3" fill="none" stroke="url(#avRim)" stroke-width=".5"/>
        <ellipse cx="-3.6" cy="-6.2" rx="3.8" ry="1.3" fill="#fff" opacity=".4" transform="rotate(-32 -3.6 -6.2)"/>
        <use href="#person"/>
      </g>
    </g>
  </g>

  <!-- ==================== ENVELOPE ==================== -->
  <!-- ground shadow -->
  <ellipse cx="129" cy="79.5" rx="40" ry="3" fill="#4b3fb0" opacity=".24" filter="url(#blur2)"/>

  <g class="fc">
    <g filter="url(#shEnv)">
      <!-- inner back panel -->
      <rect x="94" y="36" width="70" height="40" rx="8" fill="url(#envBack)"/>
      <!-- open flap -->
      <path d="M97 40L129 16L161 40Z" fill="url(#envFlap)" stroke="url(#envFlap)" stroke-width="3" stroke-linejoin="round"/>
      <path d="M98.5 39L129 17.2L159.5 39" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width=".8" stroke-linecap="round" stroke-linejoin="round"/>
    </g>

    <!-- letter -->
    <g filter="url(#shLetter)">
      <rect x="108" y="12" width="42" height="52" rx="4.5" fill="url(#paper)"/>
    </g>
    <rect x="108" y="12" width="42" height="52" rx="4.5" fill="none" stroke="#e6eaf7" stroke-width=".6"/>
    <rect x="115" y="19" width="23" height="5" rx="2.5" fill="url(#bar)"/>
    <rect x="115.6" y="19.6" width="14" height="1.3" rx=".65" fill="#fff" opacity=".4"/>
    <rect x="115" y="29" width="28" height="3.1" rx="1.55" fill="#d7ddef"/>
    <rect x="115" y="35" width="19" height="3.1" rx="1.55" fill="#e4e8f5"/>
    <rect x="108" y="30" width="42" height="11" fill="url(#paperShade)"/>

    <!-- envelope front -->
    <g clip-path="url(#frontClip)">
      <rect x="94" y="40" width="70" height="36" fill="url(#envBody)"/>
      <!-- side panels -->
      <path d="M94 40L129 61L94 78Z" fill="url(#panL)"/>
      <path d="M164 40L129 61L164 78Z" fill="url(#panR)"/>
      <!-- bottom panel -->
      <path d="M94 78L129 61L164 78Z" fill="url(#panB)"/>
      <!-- creases -->
      <path d="M94 40L129 61L164 40" fill="none" stroke="#fff" stroke-opacity=".38" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M94 77L129 61.5L164 77" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M94 77L129 62.5L164 77" fill="none" stroke="#3a2ea0" stroke-opacity=".18" stroke-width=".8"/>
      <!-- top-left gloss -->
      <path d="M94 40H164V52C140 47 116 47 94 52Z" fill="url(#envGloss)" opacity=".55"/>
      <!-- bottom depth -->
      <rect x="94" y="62" width="70" height="14" fill="url(#envDark)"/>
    </g>
    <path d="M94 44Q94 40 98 40H160Q164 40 164 44V66Q164 76 154 76H104Q94 76 94 66Z"
          fill="none" stroke="#fff" stroke-opacity=".28" stroke-width=".7"/>
    <path d="M98 40.4H160" stroke="#fff" stroke-opacity=".7" stroke-width=".7" stroke-linecap="round"/>
  </g>

  <!-- ==================== PAPER PLANE ==================== -->
  <g class="fa">
    <g transform="translate(212 22) rotate(-12) scale(.95)">
      <g filter="url(#shPlane)">
        <!-- upper wing -->
        <path d="M22 -6L-14 -14L-5 -1Z" fill="url(#pWingTop)" stroke="url(#pWingTop)" stroke-width=".6" stroke-linejoin="round"/>
        <!-- lower wing -->
        <path d="M22 -6L-5 -1L-9 9Z" fill="url(#pWingLow)" stroke="url(#pWingLow)" stroke-width=".6" stroke-linejoin="round"/>
        <!-- keel fold -->
        <path d="M-5 -1L-9 9L-1.5 4.6Z" fill="url(#pFold)" stroke="url(#pFold)" stroke-width=".5" stroke-linejoin="round"/>
      </g>
      <!-- highlights -->
      <path d="M21 -6.2L-13 -13.6" stroke="#fff" stroke-opacity=".7" stroke-width=".6" stroke-linecap="round"/>
      <path d="M21.4 -5.8L-4.6 -1.2" stroke="#fff" stroke-opacity=".35" stroke-width=".5" stroke-linecap="round"/>
    </g>
  </g>

  <!-- ==================== SPARKLES ==================== -->
  <!-- blue -->
  <g class="tw">
    <use href="#spk" transform="translate(24 45) scale(6.4)" fill="#6da8ff" opacity=".35" filter="url(#blur1)"/>
    <use href="#spk" transform="translate(24 45) scale(6)" fill="url(#spBlue)"/>
  </g>
  <g class="tw tw2">
    <use href="#spk" transform="translate(90 13) scale(4.6)" fill="url(#spBlue)"/>
  </g>
  <g class="tw tw3">
    <use href="#spk" transform="translate(16 66) scale(2.6)" fill="url(#spBlue)" opacity=".8"/>
  </g>

  <!-- orange / pink -->
  <g class="tw tw2">
    <use href="#spk" transform="translate(238 52) scale(6)" fill="#ffa53c" opacity=".35" filter="url(#blur1)"/>
    <use href="#spk" transform="translate(238 52) scale(5.6)" fill="url(#spOrange)"/>
  </g>
  <g class="tw">
    <use href="#spk" transform="translate(214 62) scale(3.6)" fill="url(#spPink)"/>
  </g>
  <g class="tw tw3">
    <use href="#spk" transform="translate(236 25) scale(2.6)" fill="url(#spOrange)" opacity=".85"/>
  </g>

  <!-- micro particles -->
  <g fill="#fff">
    <circle cx="80" cy="40" r=".6" opacity=".9"/>
    <circle cx="176" cy="18" r=".7" opacity=".8"/>
    <circle cx="200" cy="68" r=".6" opacity=".7"/>
    <circle cx="8" cy="30" r=".6" opacity=".8"/>
  </g>
</svg>