{
  "name": "whatsapp-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:admin\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:admin": "cd admin && npm run dev",
    "dev:tunnel": "bash scripts/dev-tunnel.sh",
    "install:all": "cd server && npm install && cd ../client && npm install && cd ../admin && npm install",
    "build": "npm run build:client && npm run build:admin && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:admin": "cd admin && npm run build",
    "build:server": "cd server && npm run build",
    "start": "cd server && npm run start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "cd server && npm run db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "openai": "^7.3.0"
  }
}
