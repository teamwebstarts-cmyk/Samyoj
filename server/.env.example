# # =============================================================================
# # WhatsApp Platform — Server Environment (Local Development)
# # =============================================================================

# # --- Server ---
# PORT=8000
# NODE_ENV=development
# LOG_LEVEL=debug
# CLIENT_URL=http://localhost:3000
# BASE_URL=http://localhost:8000
# SERVER_URL=http://localhost:8000

# # --- Database (PostgreSQL) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_platform

# # --- Redis (BullMQ queues + caching) ---
# REDIS_URL=redis://localhost:6379

# # --- JWT Authentication ---
# JWT_SECRET=your-jwt-secret-64-hex-chars
# JWT_REFRESH_SECRET=your-jwt-refresh-secret-64-hex-chars
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# # --- Meta WhatsApp Cloud API ---
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret
# META_VERIFY_TOKEN=your-verification-token
# META_API_VERSION=v25.0
# META_REDIRECT_URI=http://localhost:3000/settings/whatsapp/callback
# NGROK_AUTHTOKEN=your-ngrok-authtoken
# META_WEBHOOK_URL=https://your-tunnel.ngrok-free.dev/api/whatsapp/webhook

# # --- Encryption (32 bytes hex) ---
# ENCRYPTION_KEY=your-encryption-key-64-hex-chars

# # --- Azure OpenAI (EMBEDDINGS ONLY — Sarvam has no vector API) ---
# Used for knowledge-base semantic search (RAG). NOT the chat brain.
# Chat + voice brain is Sarvam (AI_BRAIN_PROVIDER=sarvam).
AZURE_OPENAI_ENDPOINT=https://skillrai.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Sarvam AI (One vendor: Brain + Voice) ---
# # Chat brain, STT, TTS — all Sarvam. https://dashboard.sarvam.ai
# AI_BRAIN_PROVIDER=sarvam
# SARVAM_API_KEY=your-sarvam-api-key
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_CHAT_TIMEOUT_MS=30000
# CALLING_VOICE_PROVIDER=sarvam
# SARVAM_STT_MODEL=saaras:v3-realtime
# SARVAM_STT_MODE=codemix
# SARVAM_STT_LANGUAGE=hi-IN
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_SAMPLE_RATE=16000
# CALLING_AI_AUTO_ANSWER=true
# CALLING_AI_GREETING=Hello! Thank you for calling. How can I help you today?

# # --- Razorpay (billing) ---
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# # --- Alerts & SLA ---
# ALERT_CHECK_INTERVAL_MS=30000
# DEFAULT_SLA_MINUTES=15
