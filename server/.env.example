# =============================================================================
# WhatsApp Platform — Server Environment
# Copy to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Server ---
PORT=8000
NODE_ENV=development
LOG_LEVEL=debug
CLIENT_URL=http://localhost:3000
BASE_URL=http://localhost:8000
# On GitHub Codespaces, set these to your forwarded HTTPS URLs, e.g.:
# CLIENT_URL=https://<codespace-name>-3000.app.github.dev
# BASE_URL=https://<codespace-name>-8000.app.github.dev
# META_REDIRECT_URI=https://<codespace-name>-3000.app.github.dev/settings/whatsapp/callback

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_platform

# --- Redis (BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- JWT Authentication ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Meta WhatsApp Cloud API ---
# Optional platform defaults. Each organization can configure App ID + Secret in Settings → WhatsApp.
# https://developers.facebook.com/apps/ → Your App → Settings → Basic
META_APP_ID=
META_APP_SECRET=
# Webhook verify token — use the same value in Meta Developer Console
META_VERIFY_TOKEN=your_webhook_verify_token
META_API_VERSION=v21.0
META_REDIRECT_URI=http://localhost:3000/settings/whatsapp/callback
# IMPORTANT: This URI (or the dynamic browser-origin equivalent) MUST also be listed under
# Meta App → Facebook Login for Business → Valid OAuth Redirect URIs.
# On Codespaces use the public frontend URL, not localhost.
# Public HTTPS webhook URL (required for incoming messages only; optional for campaigns)
# Example: https://your-tunnel.trycloudflare.com/api/whatsapp/webhook
# Note: WhatsApp connect still links your WABA to this app even when this is empty.
META_WEBHOOK_URL=

# --- Encryption (32 bytes hex — for encrypting access tokens) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Azure OpenAI (AI Chatbot) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- WhatsApp AI Calling ---
# Deepgram streaming STT for voice calls
DEEPGRAM_API_KEY=your_deepgram_api_key
# Speech recognition language for caller audio (hi, en, en-IN, multi)
DEEPGRAM_LANGUAGE=hi
# Google Cloud TTS service account JSON path (relative to server/ or absolute)
GOOGLE_APPLICATION_CREDENTIALS=key.json
# Google TTS voice (e.g. en-IN-Neural2-A, hi-IN-Neural2-A)
GOOGLE_TTS_VOICE=en-IN-Neural2-A
GOOGLE_TTS_LANGUAGE=en-IN
# Auto-answer incoming WhatsApp calls with AI bot (true/false)
CALLING_AI_AUTO_ANSWER=true
# Greeting spoken when AI picks up a call
CALLING_AI_GREETING=Hello! Thank you for calling. How can I help you today?

# --- Email (invites, password reset) ---
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Media storage (local or s3) ---
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# --- Public API URL (for media links, OAuth callbacks) ---
SERVER_URL=http://localhost:8000

# --- Razorpay (billing) ---
RAZORPAY_KEY_ID=rzp_test_SvXhCvbpS0yxLJ
RAZORPAY_KEY_SECRET=jfi8hTE0lOjHA1UFGEJZzfF8
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_8fK29xLmN7QpR4vYt3ZdW6aBc9HsE2Jn

# --- Alerts & SLA ---
ALERT_CHECK_INTERVAL_MS=30000
DEFAULT_SLA_MINUTES=15

# --- Compliance ---
# Delay before purge after delete request (default 30 days)
COMPLIANCE_PURGE_DELAY_MS=2592000000

# --- OAuth login (Google / Microsoft) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
