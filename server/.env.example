# # =============================================================================
# # WhatsApp Platform — Server Environment (Local Development)
# # =============================================================================

# # --- Server ---
# PORT=8000
# NODE_ENV=development
# LOG_LEVEL=debug
# CLIENT_URL=http://localhost:3000
# # Exact origin for /api/platform CORS + login (admin Vite :3001). Required HTTPS in production.
# PLATFORM_ADMIN_URL=http://localhost:3001
# # Local/dev: skip platform-admin TOTP (email/password is enough). Production default is true.
# PLATFORM_MFA_REQUIRED=false
# # First platform operator (run once: npm run platform:bootstrap-operator). Password only via env, not CLI.
# PLATFORM_OPERATOR_EMAIL=admin@samyoj.com
# PLATFORM_OPERATOR_PASSWORD=replace-with-a-strong-password
# BASE_URL=http://localhost:8000
# SERVER_URL=http://localhost:8000

# # --- Database (PostgreSQL) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_platform

# # --- Redis (BullMQ queues + caching) ---
# REDIS_URL=redis://localhost:6379

# # --- JWT Authentication ---
# JWT_SECRET=generate-a-strong-jwt-secret
# JWT_REFRESH_SECRET=generate-a-strong-refresh-secret
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# OAUTH_STATE_SECRET=replace-with-a-strong-random-secret

# # --- Meta WhatsApp Cloud API ---
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=replace-with-your-meta-app-secret
# META_VERIFY_TOKEN=generate-a-random-verify-token
# META_API_VERSION=v25.0
# Local Connect needs HTTPS — start.sh + ngrok on :3000 sets these automatically:
# CLIENT_URL, META_REDIRECT_URI, META_WEBHOOK_URL (do not hand-edit unless you know the tunnel URL).
# VPS: META_REDIRECT_URI=https://app.samyoj.com/settings/whatsapp/callback/popup
# NGROK_AUTHTOKEN=replace-with-your-ngrok-authtoken
# Optional: your ngrok free static domain (dashboard → Domains). start.sh uses it so the public URL stays the same.
# NGROK_STATIC_DOMAIN=your-name.ngrok-free.dev
# V8 Connect defaults to Embedded Signup v4. Production rejects META_CONNECT_FLOW=oauth.
# META_CONNECT_FLOW=es_v4
# META_ES_CONFIG_ID=your-embedded-signup-v4-configuration-id
# META_ES_COEX_CONFIG_ID=optional-coexistence-configuration-id
# Local only — never set on the VPS.
# META_ALLOW_TUNNEL_WEBHOOK=true
# VPS inbound (required in production):
# META_WEBHOOK_URL=https://app.samyoj.com/api/whatsapp/webhook
# META_PRODUCTION_WEBHOOK_URL=https://app.samyoj.com/api/whatsapp/webhook

# # --- Encryption (32 bytes hex) ---
# ENCRYPTION_KEY=generate-a-64-character-hex-key

# # --- Azure OpenAI (EMBEDDINGS ONLY — Sarvam has no vector API) ---
# # Used for knowledge-base semantic search (RAG). NOT the chat brain.
# # Chat + voice brain is Sarvam (AI_BRAIN_PROVIDER=sarvam).
# # Set your real Azure key here or embeddings/RAG search will be unavailable.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=replace-with-your-azure-api-key
# AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# # --- Sarvam AI (One vendor: Brain + Voice) ---
# # Chat brain, STT, TTS — all Sarvam. https://dashboard.sarvam.ai
# AI_BRAIN_PROVIDER=sarvam
# SARVAM_API_KEY=replace-with-your-sarvam-api-key
# GMI Cloud image generation (Hunyuan). Never commit the real key.
# GMI_IMAGE_API_KEY=
# GMI_IMAGE_MODEL=hy-image-v3.5-preview
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_CHAT_TIMEOUT_MS=60000
# CALLING_VOICE_PROVIDER=sarvam
# SARVAM_STT_MODEL=saaras:v3-realtime
# SARVAM_STT_MODE=codemix
# SARVAM_STT_LANGUAGE=auto
# SARVAM_STT_STREAM_TYPE=fast
# SARVAM_STT_SILENCE_MS=650
# SARVAM_STT_MIN_SPEECH_MS=280
# --- Voice call latency (aggressive low-latency mode) ---
# SARVAM_STT_SILENCE_MS=450
# SARVAM_VOICE_ECHO_TAIL_MS=350
# SARVAM_VOICE_EARLY_TTS_MIN_CHARS=16
# CALLING_VOICE_TIMING_LOG=true
# SARVAM_VOICE_KB_FAST=true
# SARVAM_VOICE_STREAM_TTS=true
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_SAMPLE_RATE=16000
# CALLING_AI_AUTO_ANSWER=true
# CALLING_AI_GREETING=Hello! Thank you for calling. How can I help you today?

# # --- Razorpay (billing) ---
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# BILLING_SUPPLIER_NAME=Samyoj
# BILLING_SUPPLIER_GSTIN=
# BILLING_SUPPLIER_ADDRESS=
# BILLING_SUPPLIER_STATE_CODE=
# BILLING_SAC_CODE=998314
# BILLING_GRACE_DAYS=5
# BILLING_TEST_BYPASS=false

# # --- SMTP (platform outreach + password reset). Unset = log only, no real send. ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=noreply@localhost

# # --- Alerts & SLA ---
# ALERT_CHECK_INTERVAL_MS=30000
# DEFAULT_SLA_MINUTES=15
# #
