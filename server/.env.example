# =============================================================================
# WhatsApp Platform — Server Environment (Local Development)
# =============================================================================
#
# OPTIONAL: Doppler secrets layer (https://doppler.com)
#   server/.env is the source of truth for local dev and works standalone.
#   To opt in to Doppler-injected secrets instead:
#     bash scripts/doppler-setup.sh        # install CLI, link project, push .env
#     cd server && npm run dev:doppler     # run API with Doppler secrets
#   or: USE_DOPPLER=1 bash start.sh
#   Doppler values take precedence; anything not in Doppler falls back to
#   server/.env (dotenv never overrides existing env vars).
# =============================================================================

# --- Server ---
PORT=8000
NODE_ENV=development
LOG_LEVEL=debug
CLIENT_URL=http://localhost:3000
BASE_URL=http://localhost:8000
SERVER_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_platform

# --- Redis (BullMQ queues + caching) ---
REDIS_URL=redis://localhost:6379

# --- JWT Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-char-hex
JWT_REFRESH_SECRET=replace-with-64-char-hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Meta WhatsApp Cloud API ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=replace-with-random-verify-token
META_API_VERSION=v25.0
META_REDIRECT_URI=http://localhost:3000/settings/whatsapp/callback
NGROK_AUTHTOKEN=your_ngrok_authtoken
META_WEBHOOK_URL=

# --- Encryption (exactly 64 hex chars = 32 bytes) ---
ENCRYPTION_KEY=replace-with-64-char-hex

# --- Azure OpenAI (EMBEDDINGS ONLY — Sarvam has no vector API) ---
# Used for knowledge-base semantic search (RAG). NOT the chat brain.
# Chat + voice brain is Sarvam (AI_BRAIN_PROVIDER=sarvam).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Sarvam AI (One vendor: Brain + Voice) ---
# Chat brain, STT, TTS — all Sarvam. https://dashboard.sarvam.ai
AI_BRAIN_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_CHAT_TIMEOUT_MS=30000
CALLING_VOICE_PROVIDER=sarvam
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_MODE=codemix
SARVAM_STT_LANGUAGE=auto
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_SAMPLE_RATE=16000
CALLING_AI_AUTO_ANSWER=true
CALLING_AI_GREETING=Hello! Thank you for calling. How can I help you today?

# --- Razorpay (billing) ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Alerts & SLA ---
ALERT_CHECK_INTERVAL_MS=30000
DEFAULT_SLA_MINUTES=15
