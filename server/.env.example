# =============================================================================
# WhatsApp Platform — Server Environment (Local Development)
# =============================================================================
#
# Copy this file to .env and fill in the values.
# Never commit .env to git.
#
# --- Server ---
PORT=8000
NODE_ENV=development
LOG_LEVEL=debug
CLIENT_URL=http://localhost:3000
BASE_URL=http://localhost:8000
SERVER_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_platform

# --- Redis (BullMQ queues + caching) ---
REDIS_URL=redis://localhost:6379

# --- JWT Authentication ---
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string
JWT_REFRESH_SECRET=replace-with-another-secure-random-32-byte-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google Sign-In (Continue with Google) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URI (must match exactly):
#   http://localhost:8000/api/auth/oauth/google/callback
# Production: https://YOUR_API_HOST/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email / SMTP (forgot-password + email verification + team invites) ---
# Without SMTP_HOST, emails are only logged to the API console (dev-friendly).
EMAIL_FROM=Samyoj <noreply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Meta WhatsApp Cloud API ---
# Get these from https://developers.facebook.com/apps
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=replace-with-a-random-string-e.g-wa_ce10dbd95d0978d23b06f86a702887c258d6d3fd6a2e44e9
META_API_VERSION=v25.0

# --- ngrok (for inbound webhook tunnel) ---
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
# After running: ngrok config add-authtoken <YOUR_TOKEN>
NGROK_AUTHTOKEN=

# --- OAuth redirect URI ---
# Local dev: http://localhost:3000/settings/whatsapp/callback
# ngrok: update after tunnel starts (script auto-updates META_WEBHOOK_URL)
META_REDIRECT_URI=http://localhost:3000/settings/whatsapp/callback

# --- Webhook URL (auto-updated by scripts/dev-tunnel.sh) ---
# Do NOT edit manually — let the tunnel script set this.
META_WEBHOOK_URL=

# --- Encryption (32 bytes hex) ---
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-32-byte-hex-generated-by-openssl-rand-hex-32

# --- Azure OpenAI (AI Chatbot) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- WhatsApp AI Calling ---
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_LANGUAGE=hi
GOOGLE_APPLICATION_CREDENTIALS=key.json
GOOGLE_TTS_VOICE=en-IN-Neural2-A
GOOGLE_TTS_LANGUAGE=en-IN
CALLING_AI_AUTO_ANSWER=true
CALLING_AI_GREETING=Hello! Thank you for calling. How can I help you today?

# --- Razorpay (billing) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_your_webhook_secret

# --- Alerts & SLA ---
ALERT_CHECK_INTERVAL_MS=30000
DEFAULT_SLA_MINUTES=15
