{
  "name": "whatsapp-platform-server",
  "version": "1.0.0",
  "description": "WhatsApp Automation Platform API",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "dev:doppler": "doppler run -- tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "setup-webhook": "tsx scripts/setup-webhook.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "tunnel": "bash ../scripts/ngrok-tunnel.sh",
    "test:webhook": "bash ../scripts/test-webhook.sh",
    "diagnose": "bash ../scripts/diagnose-webhook.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@roamhq/wrtc": "^0.8.0",
    "@sentry/node": "^9.5.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5",
    "winston": "^3.19.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "sharp": "^0.35.3"
  }
}
