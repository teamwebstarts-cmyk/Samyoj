generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum OrgRole {
  OWNER
  ADMIN
  SUPERVISOR
  AGENT
}

enum AgentAvailability {
  ONLINE
  AWAY
  OFFLINE
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TeamAuditAction {
  MEMBER_ADDED
  MEMBER_UPDATED
  MEMBER_REMOVED
  ROLE_CHANGED
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_REVOKED
  AVAILABILITY_CHANGED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_DELETED
  SETTINGS_CHANGED
  SESSION_REVOKED
  PASSWORD_RESET
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum ContactSource {
  MANUAL
  IMPORT
  INBOUND
  OUTBOUND
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEMPLATE
  INTERACTIVE
  LOCATION
  CONTACTS
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum CallDirection {
  USER_INITIATED
  BUSINESS_INITIATED
}

enum CallStatus {
  RINGING
  CONNECTING
  CONNECTED
  COMPLETED
  FAILED
  REJECTED
  MISSED
  TERMINATED
}

enum CallHandler {
  AI
  AGENT
  UNANSWERED
}

enum TriggerType {
  KEYWORD
  WELCOME
  AWAY
  BUSINESS_HOURS
  LEAD_CAPTURE
  AI_CHATBOT
}

enum FlowTriggerType {
  WELCOME
  KEYWORD
  ANY_MESSAGE
  BUSINESS_HOURS
  OFF_HOURS
  CONTACT_TAG
  SEGMENT
  MISSED_CALL
  CAMPAIGN_REPLY
  CALL_COMPLETED
}

enum FlowStatus {
  DRAFT
  PUBLISHED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(AGENT)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organizations         OrganizationUser[]
  assignedConversations Conversation[]     @relation("AssignedAgent")
  assignedCalls         Call[]             @relation("AssignedCallAgent")
  internalNotes         InternalNote[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  sentInvites           TeamInvite[]       @relation("SentInvites")
  auditActions          TeamAuditLog[]     @relation("AuditActor")
  auditTargets          TeamAuditLog[]     @relation("AuditTarget")

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum KnowledgeSourceType {
  FAQ
  URL
  PDF
  DOCUMENT
}

model Organization {
  id          String   @id @default(uuid())
  companyName String   @map("company_name")
  plan        String   @default("starter")
  settings    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users          OrganizationUser[]
  whatsappNumbers WhatsappNumber[]
  contacts       Contact[]
  conversations  Conversation[]
  automations    Automation[]
  flows          Flow[]
  campaigns      Campaign[]
  labels         Label[]
  aiBots         AiBot[]
  calls          Call[]
  aiUsageLogs    AiUsageLog[]
  departments    TeamDepartment[]
  teamInvites    TeamInvite[]
  teamAuditLogs     TeamAuditLog[]
  cannedReplies     CannedReply[]
  paymentOrders     PaymentOrder[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]

  planExpiresAt      DateTime? @map("plan_expires_at")
  subscriptionStatus String    @default("active") @map("subscription_status")

  @@map("organizations")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

model PaymentOrder {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  razorpayOrderId String        @unique @map("razorpay_order_id")
  planId          String        @map("plan_id")
  amountPaise     Int           @map("amount_paise")
  currency        String        @default("INR")
  status          PaymentStatus @default(CREATED)
  paymentId       String?       @map("payment_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  paidAt          DateTime?     @map("paid_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("payment_orders")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  keyHash        String    @unique @map("key_hash")
  keyPrefix      String    @map("key_prefix")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  url            String
  secret         String
  events         String[] @default([])
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("webhook_endpoints")
}

model CannedReply {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  shortcut       String
  title          String
  content        String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shortcut])
  @@map("canned_replies")
}

model OrganizationUser {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  userId              String            @map("user_id")
  role                OrgRole           @default(AGENT)
  availability        AgentAvailability @default(OFFLINE) @map("availability")
  maxConcurrentChats  Int               @default(10) @map("max_concurrent_chats")
  departmentId        String?           @map("department_id")
  permissions         Json?
  shiftSchedule       Json?             @map("shift_schedule")
  lastActiveAt        DateTime?         @map("last_active_at")
  avatarUrl           String?           @map("avatar_url")
  preferredLanguage   String            @default("en") @map("preferred_language")
  twoFactorSecret     String?           @map("two_factor_secret")
  twoFactorEnabled    Boolean           @default(false) @map("two_factor_enabled")
  mustResetPassword   Boolean           @default(false) @map("must_reset_password")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   TeamDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@map("organization_users")
}

model TeamDepartment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  color          String   @default("#10b981")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationUser[]
  invites      TeamInvite[]

  @@unique([organizationId, name])
  @@map("team_departments")
}

model TeamInvite {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  email          String
  name           String?
  orgRole        OrgRole          @default(AGENT) @map("org_role")
  departmentId   String?          @map("department_id")
  permissions    Json?
  token          String           @unique
  status         TeamInviteStatus @default(PENDING)
  invitedById    String           @map("invited_by_id")
  expiresAt      DateTime         @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  acceptedAt     DateTime?        @map("accepted_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   TeamDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  invitedBy    User            @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("team_invites")
}

model TeamAuditLog {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  actorId        String?         @map("actor_id")
  action         TeamAuditAction
  targetUserId   String?         @map("target_user_id")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?        @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("team_audit_logs")
}

model WhatsappNumber {
  id            String   @id @default(uuid())
  organizationId String  @map("organization_id")
  phoneNumber   String   @map("phone_number")
  phoneNumberId String   @map("phone_number_id")
  wabaId        String   @map("waba_id")
  businessId    String?  @map("business_id")
  accessToken   String   @map("access_token")
  webhookSecret String?  @map("webhook_secret")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  calls         Call[]
  campaigns     Campaign[]

  @@map("whatsapp_numbers")
}

model Contact {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  phone          String
  name           String?
  email          String?
  tags           String[]      @default([])
  notes          String?
  optedIn        Boolean       @default(false) @map("opted_in")
  source         ContactSource @default(MANUAL)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  calls         Call[]

  @@unique([organizationId, phone])
  @@map("contacts")
}

model Conversation {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  contactId       String             @map("contact_id")
  whatsappNumberId String?           @map("whatsapp_number_id")
  assignedAgentId String?            @map("assigned_agent_id")
  activeBotId     String?            @map("active_bot_id")
  status          ConversationStatus @default(OPEN)
  botActive       Boolean            @default(true) @map("bot_active")
  botHandoffAt    DateTime?          @map("bot_handoff_at")
  botHandoffReason String?           @map("bot_handoff_reason")
  botState        Json?              @map("bot_state")
  lastMessageAt   DateTime?          @map("last_message_at")
  unreadCount     Int                @default(0) @map("unread_count")
  firstResponseAt DateTime?          @map("first_response_at")
  slaDueAt        DateTime?          @map("sla_due_at")
  slaBreached     Boolean            @default(false) @map("sla_breached")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappNumber WhatsappNumber? @relation(fields: [whatsappNumberId], references: [id])
  assignedAgent  User?           @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  activeBot      AiBot?          @relation("ActiveBot", fields: [activeBotId], references: [id])
  messages       Message[]
  internalNotes  InternalNote[]
  labels         ConversationLabel[]
  calls          Call[]

  @@index([organizationId, lastMessageAt])
  @@map("conversations")
}

model Call {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  contactId        String        @map("contact_id")
  conversationId   String?       @map("conversation_id")
  whatsappNumberId String?       @map("whatsapp_number_id")
  aiBotId          String?       @map("ai_bot_id")
  assignedAgentId  String?       @map("assigned_agent_id")
  metaCallId       String        @unique @map("meta_call_id")
  direction        CallDirection
  status           CallStatus    @default(RINGING)
  handler          CallHandler   @default(AI)
  fromPhone        String        @map("from_phone")
  toPhone          String        @map("to_phone")
  startedAt        DateTime?     @map("started_at")
  answeredAt       DateTime?     @map("answered_at")
  endedAt          DateTime?     @map("ended_at")
  durationSeconds  Int?          @map("duration_seconds")
  transcript       Json?         @map("transcript")
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation   Conversation?  @relation(fields: [conversationId], references: [id])
  whatsappNumber WhatsappNumber? @relation(fields: [whatsappNumberId], references: [id])
  aiBot          AiBot?         @relation(fields: [aiBotId], references: [id])
  assignedAgent  User?          @relation("AssignedCallAgent", fields: [assignedAgentId], references: [id])

  @@index([organizationId, createdAt])
  @@index([conversationId])
  @@map("calls")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  metaMessageId  String?          @unique @map("meta_message_id")
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  content        String
  status         MessageStatus    @default(PENDING)
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model InternalNote {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@map("internal_notes")
}

model Label {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String
  color          String @default("#6366f1")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations ConversationLabel[]

  @@unique([organizationId, name])
  @@map("labels")
}

model ConversationLabel {
  conversationId String @map("conversation_id")
  labelId        String @map("label_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@map("conversation_labels")
}

model Automation {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  name           String
  triggerType    TriggerType @map("trigger_type")
  config         Json
  enabled        Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("automations")
}

model Flow {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  name           String
  description    String?
  triggerType    FlowTriggerType @map("trigger_type")
  triggerConfig  Json            @default("{}") @map("trigger_config")
  nodes          Json            @default("[]")
  draftNodes     Json?           @map("draft_nodes")
  startNodeId    String?         @map("start_node_id")
  status         FlowStatus      @default(PUBLISHED)
  version        Int             @default(1)
  stats          Json            @default("{}")
  enabled        Boolean         @default(true)
  priority       Int             @default(0)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     FlowVersion[]

  @@index([organizationId, enabled])
  @@map("flows")
}

model FlowVersion {
  id            String          @id @default(uuid())
  flowId        String          @map("flow_id")
  version       Int
  nodes         Json
  triggerType   FlowTriggerType @map("trigger_type")
  triggerConfig Json            @default("{}") @map("trigger_config")
  note          String?
  createdAt     DateTime        @default(now()) @map("created_at")

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, version])
  @@map("flow_versions")
}

model AiBot {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  name              String
  enabled           Boolean  @default(true)
  isDefault         Boolean  @default(false) @map("is_default")
  instructions      String   @default("")
  handoffMessage    String   @default("Let me connect you with our team. Someone will reply shortly.") @map("handoff_message")
  triggerKeywords   String[] @default([]) @map("trigger_keywords")
  handoffKeywords   String[] @default([]) @map("handoff_keywords")
  businessHoursOnly Boolean  @default(false) @map("business_hours_only")
  temperature       Float    @default(0.7)
  maxTokens         Int      @default(500) @map("max_tokens")
  rateLimitPerMin   Int      @default(30) @map("rate_limit_per_min")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeItems KnowledgeBaseItem[]
  conversations  Conversation[]      @relation("ActiveBot")
  calls          Call[]
  versions       AiBotVersion[]
  auditLogs      AiBotAuditLog[]

  @@index([organizationId])
  @@map("ai_bots")
}

model AiBotVersion {
  id         String   @id @default(uuid())
  botId      String   @map("bot_id")
  version    Int
  snapshot   Json
  changedBy  String?  @map("changed_by")
  changeNote String?  @map("change_note")
  createdAt  DateTime @default(now()) @map("created_at")

  bot AiBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, version])
  @@index([botId])
  @@map("ai_bot_versions")
}

model AiBotAuditLog {
  id             String   @id @default(uuid())
  botId          String   @map("bot_id")
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  changes        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  bot AiBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
  @@map("ai_bot_audit_logs")
}

model AiUsageLog {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  botId            String?  @map("bot_id")
  conversationId   String?  @map("conversation_id")
  action           String
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("ai_usage_logs")
}

model KnowledgeBaseItem {
  id         String              @id @default(uuid())
  botId      String              @map("bot_id")
  title      String
  content    String
  sourceType KnowledgeSourceType @default(FAQ) @map("source_type")
  sourceUrl  String?             @map("source_url")
  embedding  Json?
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  bot AiBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@map("knowledge_base_items")
}

model AutomationLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  conversationId String?  @map("conversation_id")
  automationId   String?  @map("automation_id")
  flowId         String?  @map("flow_id")
  triggerType    String   @map("trigger_type")
  action         String
  status         String
  input          Json?
  output         Json?
  error          String?
  durationMs     Int?     @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([flowId, createdAt])
  @@map("automation_logs")
}

model Campaign {
  id               String         @id @default(uuid())
  organizationId   String         @map("organization_id")
  name             String
  templateName     String         @map("template_name")
  templateLanguage String?        @map("template_language")
  templateParams   Json?          @map("template_params")
  audienceType     String         @default("MANUAL") @map("audience_type")
  audienceConfig   Json?          @map("audience_config")
  whatsappNumberId String?        @map("whatsapp_number_id")
  status           CampaignStatus @default(DRAFT)
  scheduledAt      DateTime?      @map("scheduled_at")
  timezone         String?
  pausedAt         DateTime?      @map("paused_at")
  cancelledAt      DateTime?      @map("cancelled_at")
  totalContacts    Int            @default(0) @map("total_contacts")
  sentCount        Int            @default(0) @map("sent_count")
  deliveredCount   Int            @default(0) @map("delivered_count")
  readCount        Int            @default(0) @map("read_count")
  failedCount      Int            @default(0) @map("failed_count")
  createdById      String?        @map("created_by_id")
  sentById         String?        @map("sent_by_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappNumber WhatsappNumber?   @relation(fields: [whatsappNumberId], references: [id], onDelete: SetNull)
  recipients     CampaignRecipient[]

  @@map("campaigns")
}

model CampaignRecipient {
  id            String        @id @default(uuid())
  campaignId    String        @map("campaign_id")
  phone         String
  name          String?
  variables     Json?
  status        MessageStatus @default(PENDING)
  metaMessageId String?       @unique @map("meta_message_id")
  errorMessage  String?       @map("error_message")
  retryCount    Int           @default(0) @map("retry_count")
  sentAt        DateTime?     @map("sent_at")
  deliveredAt   DateTime?     @map("delivered_at")
  readAt        DateTime?     @map("read_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  resource       String
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
