generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum OrgRole {
  OWNER
  ADMIN
  SUPERVISOR
  AGENT
}

enum AgentAvailability {
  ONLINE
  AWAY
  OFFLINE
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TeamAuditAction {
  MEMBER_ADDED
  MEMBER_UPDATED
  MEMBER_REMOVED
  ROLE_CHANGED
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_REVOKED
  AVAILABILITY_CHANGED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_DELETED
  SETTINGS_CHANGED
  SESSION_REVOKED
  PASSWORD_RESET
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum ContactSource {
  MANUAL
  IMPORT
  INBOUND
  OUTBOUND
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEMPLATE
  INTERACTIVE
  LOCATION
  CONTACTS
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  AMBIGUOUS
}

enum CallDirection {
  USER_INITIATED
  BUSINESS_INITIATED
}

enum CallStatus {
  RINGING
  CONNECTING
  CONNECTED
  COMPLETED
  FAILED
  REJECTED
  MISSED
  TERMINATED
}

enum CallHandler {
  AI
  AGENT
  UNANSWERED
}

enum TriggerType {
  KEYWORD
  WELCOME
  AWAY
  BUSINESS_HOURS
  LEAD_CAPTURE
  AI_CHATBOT
}

enum FlowTriggerType {
  WELCOME
  KEYWORD
  ANY_MESSAGE
  BUSINESS_HOURS
  OFF_HOURS
  CONTACT_TAG
  SEGMENT
  MISSED_CALL
  CAMPAIGN_REPLY
  CALL_COMPLETED
}

enum FlowStatus {
  DRAFT
  PUBLISHED
}

enum FlowAssetStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum CampaignReservationStatus {
  ACTIVE
  RELEASED
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  role            UserRole  @default(AGENT)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organizations           OrganizationUser[]
  assignedConversations   Conversation[]           @relation("AssignedAgent")
  assignedCalls           Call[]                   @relation("AssignedCallAgent")
  internalNotes           InternalNote[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvites             TeamInvite[]             @relation("SentInvites")
  auditActions            TeamAuditLog[]           @relation("AuditActor")
  auditTargets            TeamAuditLog[]           @relation("AuditTarget")
  oauthAccounts           OAuthAccount[]
  assignedLeads           Lead[]                   @relation("AssignedLeads")
  assignedTickets         Ticket[]                 @relation("AssignedTickets")

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum KnowledgeSourceType {
  FAQ
  URL
  PDF
  DOCUMENT
}

model Organization {
  id                    String   @id @default(uuid())
  companyName           String   @map("company_name")
  plan                  String   @default("starter")
  settings              Json?
  retentionDaysMessages Int      @default(365) @map("retention_days_messages")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  users                          OrganizationUser[]
  whatsappNumbers                WhatsappNumber[]
  contacts                       Contact[]
  conversations                  Conversation[]
  automations                    Automation[]
  flows                          Flow[]
  flowAssets                     FlowAsset[]
  campaigns                      Campaign[]
  campaignQuotaLedgers           CampaignQuotaLedger[]
  campaignQuotaReservations      CampaignQuotaReservation[]
  labels                         Label[]
  aiBots                         AiBot[]
  calls                          Call[]
  aiUsageLogs                    AiUsageLog[]
  departments                    TeamDepartment[]
  teamInvites                    TeamInvite[]
  teamAuditLogs                  TeamAuditLog[]
  cannedReplies                  CannedReply[]
  paymentOrders                  PaymentOrder[]
  apiKeys                        ApiKey[]
  webhookEndpoints               WebhookEndpoint[]
  catalogProducts                CatalogProduct[]
  orders                         Order[]
  brandKit                       BrandKit?
  contentDrafts                  ContentDraft[]
  generationJobs                 GenerationJob[]
  mediaAssets                    MediaAsset[]
  generationCredits              GenerationCreditLedger[]
  approvalLogs                   ApprovalLog[]
  featureFlags                   OrgFeatureFlag[]
  leads                          Lead[]
  tickets                        Ticket[]
  providerWebhookEvents          ProviderWebhookEvent[]
  unmatchedProviderStatuses      UnmatchedProviderStatus[]
  whatsappNumberIsolationReports WhatsappNumberIsolationReport[]

  planExpiresAt      DateTime? @map("plan_expires_at")
  subscriptionStatus String    @default("active") @map("subscription_status")

  @@map("organizations")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

model PaymentOrder {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  razorpayOrderId String        @unique @map("razorpay_order_id")
  planId          String        @map("plan_id")
  amountPaise     Int           @map("amount_paise")
  currency        String        @default("INR")
  status          PaymentStatus @default(CREATED)
  paymentId       String?       @map("payment_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  paidAt          DateTime?     @map("paid_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("payment_orders")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  keyHash        String    @unique @map("key_hash")
  keyPrefix      String    @map("key_prefix")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  DISABLED
}

model WebhookEndpoint {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  url            String
  secret         String
  events         String[] @default([])
  enabled        Boolean  @default(true)
  failureCount   Int      @default(0) @map("failure_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  endpointId     String                @map("endpoint_id")
  organizationId String                @map("organization_id")
  event          String
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastStatusCode Int?                  @map("last_status_code")
  lastError      String?               @map("last_error")
  requestBody    Json                  @map("request_body")
  createdAt      DateTime              @default(now()) @map("created_at")
  deliveredAt    DateTime?             @map("delivered_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([endpointId, status])
  @@map("webhook_deliveries")
}

model ConversationCharge {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  wabaId            String   @map("waba_id")
  phoneNumberId     String?  @map("phone_number_id")
  category          String
  country           String   @default("IN")
  conversationCount Int      @default(0) @map("conversation_count")
  costUsd           Float    @default(0) @map("cost_usd")
  costInr           Float    @default(0) @map("cost_inr")
  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([organizationId, wabaId, phoneNumberId, category, periodStart], map: "conversation_charges_org_waba_phone_category_period_key")
  @@index([organizationId, periodStart])
  @@map("conversation_charges")
}

model CannedReply {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  shortcut       String
  title          String
  content        String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shortcut])
  @@map("canned_replies")
}

model OrganizationUser {
  id                 String            @id @default(uuid())
  organizationId     String            @map("organization_id")
  userId             String            @map("user_id")
  role               OrgRole           @default(AGENT)
  availability       AgentAvailability @default(OFFLINE) @map("availability")
  maxConcurrentChats Int               @default(10) @map("max_concurrent_chats")
  departmentId       String?           @map("department_id")
  permissions        Json?
  shiftSchedule      Json?             @map("shift_schedule")
  lastActiveAt       DateTime?         @map("last_active_at")
  avatarUrl          String?           @map("avatar_url")
  preferredLanguage  String            @default("en") @map("preferred_language")
  twoFactorSecret    String?           @map("two_factor_secret")
  twoFactorEnabled   Boolean           @default(false) @map("two_factor_enabled")
  mustResetPassword  Boolean           @default(false) @map("must_reset_password")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   TeamDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@map("organization_users")
}

model TeamDepartment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  color          String   @default("#10b981")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationUser[]
  invites      TeamInvite[]

  @@unique([organizationId, name])
  @@map("team_departments")
}

model TeamInvite {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  email          String
  name           String?
  orgRole        OrgRole          @default(AGENT) @map("org_role")
  departmentId   String?          @map("department_id")
  permissions    Json?
  token          String           @unique
  status         TeamInviteStatus @default(PENDING)
  invitedById    String           @map("invited_by_id")
  expiresAt      DateTime         @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  acceptedAt     DateTime?        @map("accepted_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   TeamDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  invitedBy    User            @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("team_invites")
}

model TeamAuditLog {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  actorId        String?         @map("actor_id")
  action         TeamAuditAction
  targetUserId   String?         @map("target_user_id")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?        @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("team_audit_logs")
}

model WhatsappNumber {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  phoneNumber           String   @map("phone_number")
  normalizedPhoneNumber String   @map("normalized_phone_number")
  phoneNumberId         String   @map("phone_number_id")
  wabaId                String   @map("waba_id")
  businessId            String?  @map("business_id")
  accessToken           String   @map("access_token")
  webhookSecret         String?  @map("webhook_secret")
  qualityRating         String?  @map("quality_rating")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations             Conversation[]
  calls                     Call[]
  campaigns                 Campaign[]
  contacts                  Contact[]
  tickets                   Ticket[]
  leads                     Lead[]
  orders                    Order[]
  unmatchedProviderStatuses UnmatchedProviderStatus[]

  // Global unique on phoneNumberId cannot stay: inactive org A + active org B
  // must both exist (SAMYOJ-49). Partial unique WHERE is_active = true lives in SQL
  // (Prisma cannot express it). Lookups still use this index.
  @@index([phoneNumberId])
  @@unique([organizationId, id])
  @@unique([organizationId, normalizedPhoneNumber])
  @@map("whatsapp_numbers")
}

model Contact {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  phone            String
  normalizedPhone  String        @map("normalized_phone")
  whatsappNumberId String?       @map("whatsapp_number_id")
  name             String?
  email            String?
  tags             String[]      @default([])
  notes            String?
  customAttributes Json          @default("{}") @map("custom_attributes")
  optedIn          Boolean       @default(false) @map("opted_in")
  consentSource    String?       @map("consent_source")
  consentAt        DateTime?     @map("consent_at")
  consentVersion   String?       @map("consent_version")
  consentDecision  Json?         @map("consent_decision")
  optOutAt         DateTime?     @map("opt_out_at")
  source           ContactSource @default(MANUAL)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappNumber WhatsappNumber? @relation(fields: [organizationId, whatsappNumberId], references: [organizationId, id], onDelete: Restrict)
  conversations  Conversation[]
  calls          Call[]
  orders         Order[]
  leads          Lead[]
  tickets        Ticket[]

  @@unique([organizationId, whatsappNumberId, normalizedPhone])
  @@unique([organizationId, id])
  @@index([organizationId, whatsappNumberId])
  @@map("contacts")
}

model Conversation {
  id                   String               @id @default(uuid())
  organizationId       String               @map("organization_id")
  contactId            String               @map("contact_id")
  whatsappNumberId     String?              @map("whatsapp_number_id")
  assignedAgentId      String?              @map("assigned_agent_id")
  activeBotId          String?              @map("active_bot_id")
  botAssignmentSource  BotAssignmentSource? @map("bot_assignment_source")
  status               ConversationStatus   @default(OPEN)
  botActive            Boolean              @default(true) @map("bot_active")
  botHandoffAt         DateTime?            @map("bot_handoff_at")
  botHandoffReason     String?              @map("bot_handoff_reason")
  botState             Json?                @map("bot_state")
  lastMessageAt        DateTime?            @map("last_message_at")
  cs24hWindowOpensAt   DateTime?            @map("cs24h_window_opens_at")
  unreadCount          Int                  @default(0) @map("unread_count")
  firstResponseAt      DateTime?            @map("first_response_at")
  slaDueAt             DateTime?            @map("sla_due_at")
  slaBreached          Boolean              @default(false) @map("sla_breached")
  snoozedUntil         DateTime?            @map("snoozed_until")
  isFavorite           Boolean              @default(false) @map("is_favorite")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact             @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  whatsappNumber WhatsappNumber?     @relation(fields: [organizationId, whatsappNumberId], references: [organizationId, id], onDelete: Restrict)
  assignedAgent  User?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  activeBot      AiBot?              @relation("ActiveBot", fields: [activeBotId], references: [id])
  messages       Message[]
  internalNotes  InternalNote[]
  labels         ConversationLabel[]
  calls          Call[]
  orders         Order[]
  tickets        Ticket[]

  @@unique([organizationId, id])
  @@unique([organizationId, contactId, whatsappNumberId])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, snoozedUntil])
  @@index([organizationId, whatsappNumberId, botAssignmentSource])
  @@map("conversations")
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  contactId        String?   @map("contact_id")
  whatsappNumberId String?   @map("whatsapp_number_id")
  title            String
  stage            LeadStage @default(NEW)
  source           String?
  assignedAgentId  String?   @map("assigned_agent_id")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?        @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  whatsappNumber WhatsappNumber? @relation(fields: [organizationId, whatsappNumberId], references: [organizationId, id], onDelete: Restrict)
  assignedAgent  User?           @relation("AssignedLeads", fields: [assignedAgentId], references: [id])

  @@index([organizationId, stage])
  @@map("leads")
}

enum TicketStatus {
  OPEN
  PENDING
  WAITING
  RESOLVED
  CLOSED
}

enum BotAssignmentSource {
  MANUAL
  APPLIED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id               String         @id @default(uuid())
  organizationId   String         @map("organization_id")
  conversationId   String?        @map("conversation_id")
  contactId        String?        @map("contact_id")
  whatsappNumberId String?        @map("whatsapp_number_id")
  title            String
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(MEDIUM)
  category         String?
  slaDueAt         DateTime?      @map("sla_due_at")
  assignedAgentId  String?        @map("assigned_agent_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation?   @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Restrict)
  contact        Contact?        @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  whatsappNumber WhatsappNumber? @relation(fields: [organizationId, whatsappNumberId], references: [organizationId, id], onDelete: Restrict)
  assignedAgent  User?           @relation("AssignedTickets", fields: [assignedAgentId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, whatsappNumberId, status])
  @@map("tickets")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String?
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Call {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  contactId        String        @map("contact_id")
  conversationId   String?       @map("conversation_id")
  whatsappNumberId String?       @map("whatsapp_number_id")
  aiBotId          String?       @map("ai_bot_id")
  assignedAgentId  String?       @map("assigned_agent_id")
  metaCallId       String        @unique @map("meta_call_id")
  direction        CallDirection
  status           CallStatus    @default(RINGING)
  handler          CallHandler   @default(AI)
  fromPhone        String        @map("from_phone")
  toPhone          String        @map("to_phone")
  startedAt        DateTime?     @map("started_at")
  answeredAt       DateTime?     @map("answered_at")
  endedAt          DateTime?     @map("ended_at")
  durationSeconds  Int?          @map("duration_seconds")
  transcript       Json?         @map("transcript")
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact         @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Cascade)
  conversation   Conversation?   @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Restrict)
  whatsappNumber WhatsappNumber? @relation(fields: [organizationId, whatsappNumberId], references: [organizationId, id], onDelete: Restrict)
  aiBot          AiBot?          @relation(fields: [aiBotId], references: [id])
  assignedAgent  User?           @relation("AssignedCallAgent", fields: [assignedAgentId], references: [id])

  @@index([organizationId, createdAt])
  @@index([conversationId])
  @@map("calls")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  metaMessageId  String?          @unique @map("meta_message_id")
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  content        String
  status         MessageStatus    @default(PENDING)
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model InternalNote {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@map("internal_notes")
}

model Label {
